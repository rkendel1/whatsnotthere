{
  "name": "whatsnotthere",
  "version": "1.0.0",
  "description": "Website X-Ray MVP browser extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build wasm --target web --out-dir ../extension/src/wasm --out-name xray_wasm --release",
    "build": "npm run build:wasm",
    "test:js": "node --test extension/tests/**/*.test.js",
    "test:rust": "cargo test --workspace",
    "test": "npm run test:rust && npm run test:js"
  },
  "keywords": [
    "browser-extension",
    "xray",
    "api-discovery"
  ],
  "license": "MIT"
}
